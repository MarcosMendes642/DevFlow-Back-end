generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  usu_id                                BigInt           @id(map: "users_pkey") @default(autoincrement())
  usu_name                              String           @db.VarChar(100)
  usu_email                             String           @unique @db.VarChar(100)
  usu_senha                             String           @db.VarChar(100)
  usu_avatar_url                        String?          @db.VarChar(500)
  comment                               comment[]
  notification                          notification[]
  project_member                        project_member[]
  task_task_usu_id_assignee_tkTousuario task[]           @relation("task_usu_id_assignee_tkTousuario")
  task_task_usu_id_creator_tkTousuario  task[]           @relation("task_usu_id_creator_tkTousuario")
  team_member                           team_member[]
}

model comment {
  cm_id         BigInt    @id @default(autoincrement())
  cm_content    String
  tk_id_cm      BigInt
  usu_id_cm     BigInt
  cm_created_at DateTime? @default(now()) @db.Timestamp(6)
  task          task      @relation(fields: [tk_id_cm], references: [tk_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cm_task")
  usuario       usuario   @relation(fields: [usu_id_cm], references: [usu_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_usuario")
}

model github_repository {
  gh_id         BigInt    @id @default(autoincrement())
  gh_nome       String    @db.VarChar(100)
  gh_url        String    @db.VarChar(500)
  pj_id_gh      BigInt
  gh_created_at DateTime? @default(now()) @db.Timestamp(6)
  project       project   @relation(fields: [pj_id_gh], references: [pj_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_gh_project")

  @@unique([pj_id_gh, gh_url], map: "uq_gh_project_url")
}

model notification {
  nt_id         BigInt    @id @default(autoincrement())
  nt_title      String    @db.VarChar(150)
  nt_message    String?
  nt_read       Boolean   @default(false)
  usu_id_nt     BigInt
  nt_created_at DateTime? @default(now()) @db.Timestamp(6)
  usuario       usuario   @relation(fields: [usu_id_nt], references: [usu_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_nt_usuario")
}

model project {
  pj_id             BigInt              @id @default(autoincrement())
  pj_descricao      String?             @db.VarChar(100)
  pj_status         String?             @db.VarChar(100)
  pj_created_at     DateTime?           @default(now()) @db.Timestamp(6)
  pj_deadline       DateTime?           @default(now()) @db.Timestamp(6)
  tm_id_pj          BigInt
  github_repository github_repository[]
  team              team                @relation(fields: [tm_id_pj], references: [tm_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_team_id")
  project_member    project_member[]
  task              task[]
}

model project_member {
  pjmb_id     BigInt  @id @default(autoincrement())
  pjmb_role   String? @db.VarChar(40)
  pj_id_pjmb  BigInt
  usu_id_pjmb BigInt
  project     project @relation(fields: [pj_id_pjmb], references: [pj_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_id")
  usuario     usuario @relation(fields: [usu_id_pjmb], references: [usu_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_id")

  @@unique([pj_id_pjmb, usu_id_pjmb], map: "uq_project_member")
}

model task {
  tk_id                                    BigInt    @id @default(autoincrement())
  tk_titulo                                String    @db.VarChar(150)
  tk_descricao                             String?
  tk_priority                              String?   @db.VarChar(40)
  pj_id_tk                                 BigInt
  usu_id_assignee_tk                       BigInt?
  usu_id_creator_tk                        BigInt
  tk_deadline                              DateTime? @db.Timestamp(6)
  tk_created_at                            DateTime? @default(now()) @db.Timestamp(6)
  tk_status                                String    @default("todo") @db.VarChar(50)
  comment                                  comment[]
  usuario_task_usu_id_assignee_tkTousuario usuario?  @relation("task_usu_id_assignee_tkTousuario", fields: [usu_id_assignee_tk], references: [usu_id], onUpdate: NoAction, map: "fk_tk_assignee")
  usuario_task_usu_id_creator_tkTousuario  usuario   @relation("task_usu_id_creator_tkTousuario", fields: [usu_id_creator_tk], references: [usu_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tk_creator")
  project                                  project   @relation(fields: [pj_id_tk], references: [pj_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tk_project")
}

model team {
  tm_id         BigInt        @id @default(autoincrement())
  tm_nome       String        @db.VarChar(100)
  tm_created_at DateTime?     @default(now()) @db.Timestamp(6)
  project       project[]
  team_member   team_member[]
}

model team_member {
  tmm_id     BigInt  @id @default(autoincrement())
  usu_id_tmm BigInt
  tm_id_tmm  BigInt
  tmm_role   String  @db.VarChar(50)
  team       team    @relation(fields: [tm_id_tmm], references: [tm_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tmm_team")
  usuario    usuario @relation(fields: [usu_id_tmm], references: [usu_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tmm_usuario")

  @@unique([tm_id_tmm, usu_id_tmm], map: "uq_team_member")
}
