generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  usu_id         BigInt  @id(map: "users_pkey") @default(autoincrement())
  usu_name       String  @db.VarChar(100)
  usu_email      String  @unique @db.VarChar(100)
  usu_senha      String  @db.VarChar(100)
  usu_avatar_url String? @db.VarChar(500)
}
